{
  "name": "dicetalestudio",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "DiceTaleStudio 编辑器（workspace 根）",
  "scripts": {
    "dev": "pnpm --parallel --filter @dts/editor --filter @dts/backend dev",
    "dev:editor": "pnpm --filter @dts/editor dev",
    "dev:backend": "pnpm --filter @dts/backend dev",
    "build": "pnpm --filter @dts/editor build",
    "typecheck": "pnpm -r typecheck && pnpm typecheck:e2e",
    "typecheck:e2e": "tsc --noEmit -p e2e/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "e2e": "pnpm e2e:fast",
    "e2e:smoke": "pnpm build && playwright test e2e/smoke.spec.ts --project=desktop-chrome --grep-invert @runtime",
    "e2e:tablet-smoke": "pnpm build && playwright test e2e/smoke.spec.ts --project=tablet-touch-portrait --project=tablet-touch-landscape --grep-invert @runtime",
    "e2e:fast": "pnpm build && playwright test --project=desktop-chrome --grep-invert @runtime && playwright test --project=desktop-chrome --grep @runtime --workers=1",
    "e2e:full": "pnpm build && playwright test --grep-invert @runtime && playwright test --grep @runtime --workers=1",
    "check": "pnpm typecheck && pnpm test && pnpm lint"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.3",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
