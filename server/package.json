{
  "name": "dicetalestudio",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "DiceTaleStudio 编辑器（workspace 根）",
  "scripts": {
    "dev": "pnpm --parallel --filter @dts/editor --filter @dts/backend dev",
    "dev:editor": "pnpm --filter @dts/editor dev",
    "dev:backend": "pnpm --filter @dts/backend dev",
    "build": "pnpm --filter @dts/editor build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.3",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
